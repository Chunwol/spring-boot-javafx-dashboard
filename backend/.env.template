# Backend environment template
# Copy to `backend/.env` and fill secrets. DO NOT commit `.env`.

# Database Configuration
DB_URL=jdbc:postgresql://127.0.0.1:5433/dashboard_db
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=dashboard
DB_PASSWORD=REPLACE_ME_DB_PASSWORD
POSTGRES_DB=dashboard_db
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
POSTGRES_RUNTIME_ONLY=true
POSTGRES_RUNTIME_PORT=5433
DB_POOL_MAX_SIZE=64
DB_POOL_MIN_IDLE=16
JPA_DDL_AUTO=validate
JPA_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/pgmigration

# Server Configuration
SERVER_PORT=8888
SERVER_HOST=0.0.0.0
SERVER_BASE_URL=http://localhost:8888

# JWT Configuration
JWT_SECRET=REPLACE_ME_JWT_SECRET
JWT_EXPIRATION=86400000

# Mail Configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=REPLACE_ME_MAIL_PASSWORD
MAIL_FROM=noreply@example.com

# Redis (if used)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD

# Default admin credentials (for initial bootstrap only)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=REPLACE_ME_ADMIN_PASSWORD
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_SYNC_ON_STARTUP=false

# Viewer account
DEFAULT_VIEWER_USERNAME=viewer
DEFAULT_VIEWER_PASSWORD=REPLACE_ME_VIEWER_PASSWORD
DEFAULT_VIEWER_EMAIL=viewer@example.com

# Other runtime settings
UPLOAD_DIR=./uploads/
MAX_FILE_SIZE=20971520

# Note: Replace all REPLACE_ME_* values before running in production.
