# ============================================================
# deploy/.env.example
# NAS/서버 배포 시 이 파일을 .env 로 복사하고 값을 채우세요
#   cp .env.example .env
# ============================================================

# ── 도메인 / SSL ─────────────────────────────────────────────
DOMAIN=your-domain.example.com
EMAIL=your-email@example.com

# ZeroSSL EAB credentials (https://app.zerossl.com/developer)
ZEROSSL_EAB_KID=
ZEROSSL_EAB_HMAC_KEY=

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=dashboard_db
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── JWT ──────────────────────────────────────────────────────
# 반드시 32자 이상 랜덤 문자열로 변경
JWT_SECRET=CHANGE_ME_use_random_32chars_minimum
# 토큰 만료(ms). 86400000 = 24시간
JWT_EXPIRATION=86400000

# ── 기본 계정 자동 생성 ──────────────────────────────────────
DEFAULT_ADMIN_SYNC_ON_STARTUP=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_admin_password
DEFAULT_ADMIN_EMAIL=

DEFAULT_VIEWER_SYNC_ON_STARTUP=true
DEFAULT_VIEWER_USERNAME=viewer
DEFAULT_VIEWER_PASSWORD=CHANGE_ME_viewer_password
DEFAULT_VIEWER_EMAIL=

# 일반 사용자 계정(선택). SYNC=false 이면 생성 안 함 → 나머지는 비워둬도 됨
DEFAULT_USER_SYNC_ON_STARTUP=false
DEFAULT_USER_USERNAME=
DEFAULT_USER_PASSWORD=
DEFAULT_USER_EMAIL=

# ── 권한 매핑 (쉼표로 다중 지정 가능) ────────────────────────
# 비워두면 위 DEFAULT_*_USERNAME 값이 사용됨
ADMIN_USERS=admin
VIEWER_USERS=viewer

# ── Agent ─────────────────────────────────────────────────────
AGENT_INSTALL_KEY=INST-CHANGE-ME-BEFORE-DEPLOY

# ── Mail (ALERT_EMAIL 비우면 이메일 비활성화) ────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
ALERT_EMAIL=

# ── 기타 ─────────────────────────────────────────────────────
APP_NAME=Classroom Dashboard
UPLOAD_DIR=/app/uploads/
MAX_FILE_SIZE=53687091200
MAX_REQUEST_SIZE=53687091200
COLLECT_ARTIFACT_MAX_TOTAL_BYTES=53687091200
LOG_LEVEL=INFO

# ── File Distribution (30GB/800대 확산 배포 기본값) ──────────
FD_DEFAULT_WAVE_SIZE=5
FD_MAX_WAVE_SIZE=40
FD_DEFAULT_RAMP_UP_FACTOR=1.4
FD_MAX_PEER_CANDIDATES=60
FD_PEER_PORT=18777

# ── Nginx X-Accel-Redirect (대용량 파일 서빙 위임) ───────────
# Synology NAS 기본 리버스 프록시에서는 internal location 블록을
# 설정할 수 없으므로 반드시 false 로 둔다(true 로 켜면 다운로드 깨짐).
# 직접 구성한 Nginx 환경에서만 true 로 전환하고, 그때 Nginx 에
#   location /internal-uploads/ { internal; alias /app/uploads/; }
# 블록과 uploads 볼륨 마운트를 함께 설정할 것.
NGINX_ACCEL_REDIRECT=false
NGINX_INTERNAL_LOCATION=/internal-uploads/

# ── Flyway (DB 마이그레이션) ─────────────────────────────────
# 기본값 그대로 둘 것. 비활성화하면 스키마가 자동 적용되지 않음
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/pgmigration

# ── JPA ──────────────────────────────────────────────────────
# validate: 엔티티-스키마 일치만 검증(운영 권장). create/update 금지
JPA_DDL_AUTO=validate
# true 로 두면 모든 SQL 이 로그에 출력됨(운영에서는 false)
JPA_SHOW_SQL=false
