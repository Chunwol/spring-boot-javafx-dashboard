# FRONTEND ENV TEMPLATE
# Copy this file to `frontend/.env` for local development and do NOT commit secrets.

# API Server Configuration
API_SERVER_PROTOCOL=http
API_SERVER_HOST=localhost
API_SERVER_PORT=8888

# Backend Base URL (optional override). If set, takes precedence over the protocol/host/port above.
API_BASE_URL=

# WebSocket Configuration
WEBSOCKET_PROTOCOL=ws
WEBSOCKET_HOST=localhost
WEBSOCKET_PORT=8888

# UI Configuration
APP_NAME=Classroom Dashboard
APP_THEME=light

# Logging
LOG_LEVEL=INFO

# Refresh intervals (milliseconds)
REFRESH_INTERVAL_DASHBOARD=15000
REFRESH_INTERVAL_HEARTBEAT=120000

# Traffic threshold defaults (non-sensitive)
TRAFFIC_ALERT_THRESHOLD_GLOBAL_MBPS=5000
TRAFFIC_ALERT_THRESHOLD_CLASSROOM_MBPS=1000
TRAFFIC_ALERT_THRESHOLD_PC_MBPS=300

# Cache
CACHE_PANEL_POSITIONS=true
CACHE_DASHBOARD_STATE=true

# Debug
DEBUG_MODE=false
