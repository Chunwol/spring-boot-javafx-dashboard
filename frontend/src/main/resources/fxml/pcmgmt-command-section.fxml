<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0" styleClass="pcmgmt-command-divider"
      xmlns:fx="http://javafx.com/fxml">
    <children>
        <FlowPane fx:id="commandControlsFlow" hgap="10.0" vgap="8.0" prefWrapLength="780.0" alignment="CENTER_LEFT">
            <children>
                <!-- 대상 콤보 제거 — 체크박스로 PC 직접 선택, 없으면 전체 -->
                <Label fx:id="selectionHintLabel" styleClass="pcmgmt-selection-hint" />
                <Label text="명령:" styleClass="pcmgmt-command-label" />
                <ComboBox fx:id="commandCombo" prefWidth="180.0" promptText="명령 선택" />
                <Button fx:id="sendBtn" text="▶ 전송" styleClass="btn-primary">
                    <tooltip><Tooltip text="체크된 PC에 명령 전송 (없으면 전체)" /></tooltip>
                </Button>
                <Separator orientation="VERTICAL" prefHeight="26.0" />
                <Button fx:id="rolloutBtn" text="⬆ 에이전트 업데이트" styleClass="btn-warning">
                    <tooltip><Tooltip text="MSI 업로드 후 체크된 PC(없으면 전체)에 배포" /></tooltip>
                </Button>
            </children>
        </FlowPane>
    </children>
</VBox>
