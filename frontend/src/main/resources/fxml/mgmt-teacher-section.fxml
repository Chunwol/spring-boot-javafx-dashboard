<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="teacherBox" spacing="12" alignment="TOP_LEFT" styleClass="tab-main"
      maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
    <children>
        <Label text="교사 PC 관리" styleClass="mgmt-section-title" />
        <Label text="* 표시(강의실·교사 IP)는 필수 입력 항목입니다."
               styleClass="mgmt-hint-label" wrapText="true" />

        <HBox fx:id="teacherForm" spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <ComboBox fx:id="teacherGroupCombo" promptText="* 강의실 선택">
                    <tooltip><Tooltip text="필수 — 교사 PC가 속한 강의실" /></tooltip>
                </ComboBox>
                <TextField fx:id="teacherIp"   promptText="* 교사 IP" prefWidth="160.0">
                    <tooltip><Tooltip text="필수 — 교사 PC의 IP 주소 (예: 192.168.1.2)" /></tooltip>
                </TextField>
                <TextField fx:id="teacherMac"  promptText="교사 MAC (선택)" prefWidth="160.0">
                    <tooltip><Tooltip text="선택 — 알고 있으면 입력 (예: AA:BB:CC:DD:EE:FF)" /></tooltip>
                </TextField>
                <TextField fx:id="teacherDesc" promptText="설명 (선택)" HBox.hgrow="ALWAYS">
                    <tooltip><Tooltip text="선택 — 교사명이나 메모" /></tooltip>
                </TextField>
                <Button fx:id="addTeacherBtn" text="교사 등록" styleClass="btn-primary,btn-sm" />
            </children>
        </HBox>

        <TableView fx:id="teacherDeviceTable" styleClass="app-table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
            </columnResizePolicy>
            <placeholder><Label text="등록된 교사 PC가 없습니다." /></placeholder>
            <columns>
                <TableColumn text="번호">
                    <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
                </TableColumn>
                <TableColumn text="강의실">
                    <cellValueFactory><PropertyValueFactory property="groupName" /></cellValueFactory>
                </TableColumn>
                <TableColumn text="IP 주소">
                    <cellValueFactory><PropertyValueFactory property="ipAddress" /></cellValueFactory>
                </TableColumn>
                <TableColumn text="MAC 주소">
                    <cellValueFactory><PropertyValueFactory property="macAddress" /></cellValueFactory>
                </TableColumn>
                <TableColumn text="설명">
                    <cellValueFactory><PropertyValueFactory property="description" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="teacherActionCol" text="관리" styleClass="table-col-center" />
            </columns>
        </TableView>
    </children>
</VBox>
