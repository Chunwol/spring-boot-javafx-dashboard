<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<GridPane hgap="10.0" vgap="8.0" styleClass="dialog-content"
          xmlns:fx="http://javafx.com/fxml">
    <padding><Insets topRightBottomLeft="12.0" /></padding>

    <Label text="유형과 시작일·종료일을 모두 선택해야 합니다."
           styleClass="mgmt-hint-label" wrapText="true"
           GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2" />

    <Label text="유형:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
        <children>
            <RadioButton fx:id="weeklyBtn" text="주간 보고서" />
            <RadioButton fx:id="monthlyBtn" text="월간 보고서" />
        </children>
    </HBox>
    <Label text="시작일:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
    <DatePicker fx:id="fromPicker" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    <Label text="종료일:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
    <DatePicker fx:id="toPicker" GridPane.columnIndex="1" GridPane.rowIndex="3" />
</GridPane>
