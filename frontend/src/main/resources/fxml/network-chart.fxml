<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>

<LineChart fx:id="networkChart" title="실시간 전체 네트워크 트래픽"
           createSymbols="false" animated="false"
           styleClass="network-chart-font"
           xmlns:fx="http://javafx.com/fxml">
    <xAxis>
        <CategoryAxis fx:id="chartXAxis" label="시간" styleClass="network-chart-font" />
    </xAxis>
    <yAxis>
        <NumberAxis fx:id="chartYAxis" label="트래픽 (Mbps)" styleClass="network-chart-font" />
    </yAxis>
</LineChart>
