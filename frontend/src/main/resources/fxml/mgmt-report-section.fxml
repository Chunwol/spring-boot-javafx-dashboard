<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" alignment="TOP_LEFT" styleClass="tab-main"
      maxWidth="1.7976931348623157E308"
      xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
    <children>
        <Label fx:id="reportTitle" text="주간/월간 보고서" styleClass="tab-title" />
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Button fx:id="weekBtn" text="주간 보고서 생성" styleClass="btn-success" />
                <Button fx:id="monthBtn" text="월간 보고서 생성" styleClass="btn-primary" />
            </children>
        </HBox>
    </children>
</VBox>
