<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="ipBox" spacing="12" alignment="TOP_LEFT" styleClass="tab-main"
      maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
    <children>
        <Label text="강의실 IP 대역 관리" styleClass="mgmt-section-title" />
        <Label text="강의실을 선택하면 해당 강의실 IP 대역만 표시됩니다. * 표시(시작 IP·끝 IP)는 필수이며, 올바른 IPv4 형식으로 입력하세요."
               styleClass="mgmt-hint-label" wrapText="true" />

        <HBox fx:id="ipForm" spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <ComboBox fx:id="groupComboBox" promptText="강의실 선택 (전체)" prefWidth="180.0" />
                <TextField fx:id="startIpField" promptText="* 시작 IP (예: 192.168.1.10)" prefWidth="190.0">
                    <tooltip><Tooltip text="필수 — 대역 시작 IPv4 주소 (예: 192.168.1.10)" /></tooltip>
                </TextField>
                <TextField fx:id="endIpField"   promptText="* 끝 IP (예: 192.168.1.30)"   prefWidth="190.0">
                    <tooltip><Tooltip text="필수 — 대역 끝 IPv4 주소 (예: 192.168.1.30)" /></tooltip>
                </TextField>
                <TextField fx:id="descField"    promptText="설명 (선택)" HBox.hgrow="ALWAYS">
                    <tooltip><Tooltip text="선택 — 대역 용도나 메모" /></tooltip>
                </TextField>
                <Button fx:id="addIpRangeBtn" text="대역 추가" styleClass="btn-primary,btn-sm" />
            </children>
        </HBox>

        <TableView fx:id="ipRangeTable" styleClass="app-table" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" /></columnResizePolicy>
            <placeholder><Label text="등록된 IP 대역이 없습니다." /></placeholder>
            <columns>
                <TableColumn text="번호" maxWidth="60.0">
                    <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
                </TableColumn>
                <TableColumn text="강의실">
                    <cellValueFactory><PropertyValueFactory property="groupName" /></cellValueFactory>
                </TableColumn>
                <TableColumn text="시작 IP">
                    <cellValueFactory><PropertyValueFactory property="startIp" /></cellValueFactory>
                </TableColumn>
                <TableColumn text="끝 IP">
                    <cellValueFactory><PropertyValueFactory property="endIp" /></cellValueFactory>
                </TableColumn>
                <TableColumn text="설명">
                    <cellValueFactory><PropertyValueFactory property="description" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="ipRangeActionCol" text="관리" minWidth="80.0" styleClass="table-col-center" />
            </columns>
        </TableView>
    </children>
</VBox>
