<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" prefWidth="760.0" prefHeight="560.0"
      xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0" /></padding>

    <!-- 상태 -->
    <VBox spacing="4.0">
        <Label text="상태" styleClass="meta-key" />
        <Label fx:id="statusValue" wrapText="true" styleClass="meta-value" />
    </VBox>

    <!-- 실행방식 -->
    <VBox spacing="4.0">
        <Label text="실행방식" styleClass="meta-key" />
        <Label fx:id="runModeValue" wrapText="true" styleClass="meta-value" />
    </VBox>

    <!-- 전송대상 -->
    <VBox spacing="4.0">
        <Label text="전송대상" styleClass="meta-key" />
        <Label fx:id="transferTargetValue" wrapText="true" styleClass="meta-value" />
    </VBox>

    <!-- 대상경로 -->
    <VBox spacing="4.0">
        <Label text="대상경로" styleClass="meta-key" />
        <Label fx:id="destinationValue" wrapText="true" styleClass="meta-value" />
    </VBox>

    <!-- 종료코드 -->
    <VBox spacing="4.0">
        <Label text="종료코드" styleClass="meta-key" />
        <Label fx:id="exitCodeValue" wrapText="true" styleClass="meta-value" />
    </VBox>

    <!-- 검증상태 -->
    <VBox spacing="4.0">
        <Label text="검증상태" styleClass="meta-key" />
        <Label fx:id="verificationValue" wrapText="true" styleClass="meta-value" />
    </VBox>

    <!-- 강의실 -->
    <VBox spacing="4.0">
        <Label text="강의실" styleClass="meta-key" />
        <Label fx:id="groupNameValue" wrapText="true" styleClass="meta-value" />
    </VBox>

    <!-- PC -->
    <VBox spacing="4.0">
        <Label text="PC" styleClass="meta-key" />
        <Label fx:id="pcNameValue" wrapText="true" styleClass="meta-value" />
    </VBox>

    <!-- IP -->
    <VBox spacing="4.0">
        <Label text="IP" styleClass="meta-key" />
        <Label fx:id="ipAddressValue" wrapText="true" styleClass="meta-value" />
    </VBox>

    <!-- 스크립트 -->
    <VBox spacing="4.0">
        <Label text="스크립트" styleClass="meta-key" />
        <Label fx:id="scriptUrlValue" wrapText="true" styleClass="meta-value" />
        <HBox spacing="8.0">
            <Button fx:id="downloadButton" text="다운로드" />
        </HBox>
    </VBox>

    <!-- Payload -->
    <VBox spacing="4.0">
        <Label text="Payload" styleClass="meta-key" />
        <Label fx:id="payloadValue" wrapText="true" styleClass="meta-value" />
    </VBox>

    <!-- stdout -->
    <VBox spacing="4.0">
        <Label text="stdout" styleClass="meta-key" />
        <TextArea fx:id="stdoutArea" editable="false" wrapText="true" prefRowCount="6" />
    </VBox>

    <!-- stderr -->
    <VBox spacing="4.0">
        <Label text="stderr" styleClass="meta-key" />
        <TextArea fx:id="stderrArea" editable="false" wrapText="true" prefRowCount="6" />
    </VBox>
</VBox>
