<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="brokenPcBox" spacing="12" alignment="TOP_LEFT" styleClass="tab-main"
      maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
    <children>
        <Label text="고장 PC 등록" styleClass="mgmt-section-title" />
        <Label text="* 표시는 필수 입력 항목입니다. IP 주소와 고장 사유는 반드시 입력하세요."
               styleClass="mgmt-hint-label" wrapText="true" />

        <HBox fx:id="brokenFilterBox" spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <ComboBox fx:id="brokenGroupCombo" promptText="강의실 필터" />
            </children>
        </HBox>

        <HBox fx:id="brokenForm" spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="brokenIpField"   promptText="* IP 주소" prefWidth="160.0">
                    <tooltip><Tooltip text="필수 — 고장 PC의 IP 주소 (예: 192.168.1.10)" /></tooltip>
                </TextField>
                <TextField fx:id="brokenMacField"  promptText="MAC 주소 (선택)" prefWidth="160.0">
                    <tooltip><Tooltip text="선택 — 알고 있으면 입력 (예: AA:BB:CC:DD:EE:FF)" /></tooltip>
                </TextField>
                <TextField fx:id="brokenNoteField" promptText="* 고장 사유" HBox.hgrow="ALWAYS">
                    <tooltip><Tooltip text="필수 — 고장 증상이나 사유를 입력하세요" /></tooltip>
                </TextField>
                <Button fx:id="brokenRegisterBtn" text="고장 등록" styleClass="btn-warning,btn-sm" />
            </children>
        </HBox>

        <TableView fx:id="brokenPcTable" styleClass="app-table" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" /></columnResizePolicy>
            <placeholder><Label text="등록된 고장 PC가 없습니다." /></placeholder>
            <columns>
                <TableColumn fx:id="brokenMacCol" text="MAC 주소" prefWidth="150.0" />
                <TableColumn fx:id="brokenIpCol" text="IP 주소" prefWidth="120.0" />
                <TableColumn fx:id="brokenGroupCol" text="강의실" prefWidth="120.0" />
                <TableColumn fx:id="brokenStatusCol" text="상태" prefWidth="80.0" />
                <TableColumn fx:id="brokenNoteCol" text="고장 사유" prefWidth="220.0" />
                <TableColumn fx:id="brokenActionCol" text="관리" minWidth="200.0" styleClass="table-col-center" />
            </columns>
        </TableView>
    </children>
</VBox>
