<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
	  fx:controller="com.example.frontend.controller.DashboardController"
	  fx:id="rootVBox"
	  spacing="10">
	<padding>
		<Insets top="8" right="8" bottom="8" left="8" />
	</padding>
	<children>
		<HBox fx:id="topBarRef" alignment="CENTER_LEFT" spacing="14" styleClass="dashboard-topbar">
			<padding>
				<Insets top="13" right="18" bottom="13" left="18" />
			</padding>
			<children>
				<VBox spacing="2">
					<children>
						<Label fx:id="dashboardTitleLabel" text="통합 강의실 관제" styleClass="dashboard-topbar-title" />
						<Label fx:id="dashboardSubtitleLabel" text="실시간 모니터링, 원격 제어, 리포팅" styleClass="dashboard-topbar-subtitle" />
					</children>
				</VBox>
				<Label fx:id="viewerModeBadgeLabel"
					   managed="false"
					   text="VIEWER | 읽기 전용"
					   visible="false"
					   styleClass="viewer-readonly-badge" />
				<HBox alignment="CENTER_LEFT" spacing="6">
					<children>
						<ComboBox fx:id="dashboardSelector" prefWidth="200.0" promptText="대시보드 선택" />
						<MenuButton fx:id="dashboardSettingsMenu" text="⚙ 설정" styleClass="dashboard-menu-button" />
					</children>
				</HBox>
				<Region HBox.hgrow="ALWAYS" />
				<StackPane fx:id="alertsButtonStack" pickOnBounds="false">
					<children>
						<Button fx:id="alertsButton" styleClass="btn-icon-action,btn-icon-alert" />
						<Label fx:id="alertsBadgeLabel"
							   managed="false"
							   text="0"
							   visible="false"
							   styleClass="alert-badge-label">
							<StackPane.alignment>TOP_RIGHT</StackPane.alignment>
							<StackPane.margin>
								<Insets top="-6" right="-8" bottom="0" left="0" />
							</StackPane.margin>
						</Label>
					</children>
				</StackPane>
				<Button fx:id="logoutButton" text="로그아웃" styleClass="btn-icon-action,btn-icon-logout" />
			</children>
		</HBox>
		<TabPane fx:id="mainTabPane" styleClass="dashboard-tabpane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
			<tabs>
				<Tab fx:id="dashboardTab" text="대시보드">
					<content>
						<SplitPane fx:id="dashboardMainSplitPane" styleClass="dashboard-splitpane">
							<items>
								<StackPane fx:id="leftPaneSlot" />
								<VBox fx:id="rightToolPane" spacing="10">
									<padding>
										<Insets top="4" right="8" bottom="8" left="8" />
									</padding>
									<children>
										<HBox fx:id="rightToolbar" alignment="CENTER_RIGHT" minHeight="-1.0" spacing="10" styleClass="dashboard-right-toolbar">
											<padding>
												<Insets top="8" right="8" bottom="8" left="8" />
											</padding>
											<children>
												<ColorPicker fx:id="bgColorPicker" />
												<ToggleButton fx:id="editModeButton" text="편집 모드" styleClass="dashboard-toolbar-toggle" />
												<ToggleButton fx:id="focusModeButton" text="포커스 모드" styleClass="dashboard-toolbar-toggle" />
												<Button fx:id="fullScreenButton" text="전체 화면" styleClass="btn-icon-action,btn-icon-fullscreen" />
												<ToggleButton fx:id="dashboardOnlyButton" text="대시보드만" styleClass="dashboard-toolbar-toggle" />
												<HBox fx:id="editOnlyToolbar" managed="false" spacing="8" visible="false">
													<children>
														<ToggleButton fx:id="gridToggleButton" text="격자" styleClass="dashboard-toolbar-mini-toggle" />
														<ToggleButton fx:id="snapToggleButton" text="스냅" styleClass="dashboard-toolbar-mini-toggle" />
														<MenuButton fx:id="alignMenuButton" text="정렬" styleClass="dashboard-toolbar-menu" />
														<MenuButton fx:id="arrangeMenuButton" text="배열" styleClass="dashboard-toolbar-menu" />
													</children>
												</HBox>
												<HBox alignment="CENTER_RIGHT" spacing="4">
													<children>
														<Button fx:id="zoomOutButton" text="-" styleClass="dashboard-zoom-btn" />
														<Button fx:id="zoomResetButtonNode" text="100%" styleClass="dashboard-zoom-btn" />
														<Button fx:id="zoomInButton" text="+" styleClass="dashboard-zoom-btn" />
														<Button fx:id="fitAllButton" text="전체 맞춤" styleClass="dashboard-zoom-btn" />
													</children>
												</HBox>
												<Button fx:id="refreshButton" text="새로고침" styleClass="btn-icon-action,btn-icon-refresh" />
											</children>
										</HBox>
										<StackPane fx:id="canvasStack" VBox.vgrow="ALWAYS">
											<children>
												<ScrollPane fx:id="dashboardScrollPane" pannable="true" fitToWidth="false" fitToHeight="false" styleClass="dashboard-canvas-scroll">
													<content>
														<Group fx:id="dashboardCanvasGroup" />
													</content>
												</ScrollPane>
												<VBox fx:id="toastContainer" mouseTransparent="true" pickOnBounds="false" spacing="8">
													<padding>
														<Insets top="12" right="12" bottom="12" left="12" />
													</padding>
													<StackPane.alignment>TOP_RIGHT</StackPane.alignment>
												</VBox>
											</children>
										</StackPane>
									</children>
								</VBox>
							</items>
						</SplitPane>
					</content>
				</Tab>
				<Tab fx:id="pcManagementTab" text="PC 관리">
					<content>
						<StackPane fx:id="pcManagementSlot" />
					</content>
				</Tab>
				<Tab fx:id="networkTab" text="네트워크">
					<content>
						<StackPane fx:id="networkSlot" />
					</content>
				</Tab>
				<Tab fx:id="commandTab" text="명령">
					<content>
						<StackPane fx:id="commandSlot" />
					</content>
				</Tab>
				<Tab fx:id="settingsTab" text="설정">
					<content>
						<StackPane fx:id="settingsSlot" />
					</content>
				</Tab>
			</tabs>
		</TabPane>
	</children>
</VBox>
