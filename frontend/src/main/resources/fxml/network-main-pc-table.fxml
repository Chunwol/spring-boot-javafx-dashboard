<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>

<TableView fx:id="mainPcTable" styleClass="app-table,network-table"
           xmlns:fx="http://javafx.com/fxml">
    <placeholder><Label text="PC 트래픽 데이터가 없습니다." styleClass="network-placeholder" /></placeholder>
    <columns>
        <TableColumn fx:id="roomCol" text="강의실" prefWidth="100.0" />
        <TableColumn fx:id="pcCol" text="호스트명" prefWidth="140.0" />
        <TableColumn fx:id="ipCol" text="IP" prefWidth="130.0" />
        <TableColumn fx:id="inCol" text="입력(Mbps)" prefWidth="100.0" />
        <TableColumn fx:id="outCol" text="출력(Mbps)" prefWidth="100.0" />
        <TableColumn fx:id="loadCol" text="부하율" prefWidth="160.0" />
        <TableColumn fx:id="statusCol" text="상태" prefWidth="80.0" />
    </columns>
    <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
    </columnResizePolicy>
</TableView>
