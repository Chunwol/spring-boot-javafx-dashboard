<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>

<HBox fx:id="header" spacing="4.0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="4" right="4" bottom="4" left="4" /></padding>
    <children>
        <Button fx:id="deleteBtn"   text="삭제" styleClass="btn-danger,btn-sm">
            <tooltip><Tooltip text="텍스트 위젯 삭제" /></tooltip>
        </Button>
        <Button fx:id="boldBtn"     text="B" styleClass="btn-neutral,btn-sm">
            <tooltip><Tooltip text="굵게" /></tooltip>
        </Button>
        <Button fx:id="italicBtn"   text="I" styleClass="btn-neutral,btn-sm">
            <tooltip><Tooltip text="기울임" /></tooltip>
        </Button>
        <Button fx:id="sizeDownBtn" text="A-" styleClass="btn-neutral,btn-sm">
            <tooltip><Tooltip text="글자 크기 줄이기" /></tooltip>
        </Button>
        <Button fx:id="sizeUpBtn"   text="A+" styleClass="btn-neutral,btn-sm">
            <tooltip><Tooltip text="글자 크기 키우기" /></tooltip>
        </Button>
        <ColorPicker fx:id="colorPicker" prefWidth="54.0">
            <tooltip><Tooltip text="글자 색상 변경" /></tooltip>
        </ColorPicker>
    </children>
</HBox>
