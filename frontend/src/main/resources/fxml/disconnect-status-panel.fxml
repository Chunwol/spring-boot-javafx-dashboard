<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" styleClass="module-panel-wrapper"
      xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="16.0" right="14.0" bottom="14.0" left="14.0" /></padding>
    <children>
        <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="module-panel-header">
            <padding><Insets top="8.0" right="10.0" bottom="8.0" left="10.0" /></padding>
            <children>
                <Label fx:id="titleLabel" text="접속현황 패널" styleClass="module-panel-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="deleteBtn" text="삭제" styleClass="module-panel-delete-btn" />
            </children>
        </HBox>

        <Label fx:id="summaryLabel" styleClass="module-panel-summary" />

        <TableView fx:id="logTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            <placeholder><Label text="아직 접속 상태 변경 로그가 없습니다." /></placeholder>
            <columns>
                <TableColumn fx:id="timeCol" text="시간" prefWidth="150.0" />
                <TableColumn fx:id="classroomCol" text="강의실" prefWidth="120.0" />
                <TableColumn fx:id="pcCol" text="PC명" prefWidth="160.0" />
                <TableColumn fx:id="statusCol" text="이벤트" prefWidth="110.0" />
            </columns>
        </TableView>

        <StackPane fx:id="resizeHandleHolder" pickOnBounds="false" />
    </children>
</VBox>
