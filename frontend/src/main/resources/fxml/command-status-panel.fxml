<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns:fx="http://javafx.com/fxml" spacing="0"
      maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308">

    <!-- ━━━━━━━━━━━━━━━━━━━ LEFT: 필터 + 명령 테이블 ━━━━━━━━━━━━━━━━━━━ -->
    <VBox spacing="8" styleClass="tab-main" HBox.hgrow="ALWAYS">
        <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
        <children>
            <HBox alignment="CENTER_LEFT" spacing="6">
                <children>
                    <Label text="명령 발행 / 이력" styleClass="tab-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="refreshButton" text="새로고침" styleClass="btn-primary">
                        <tooltip><Tooltip text="최신 명령 실행 상태를 다시 조회합니다" /></tooltip>
                    </Button>
                </children>
            </HBox>

            <Label fx:id="summaryLabel" text="조회 중..." styleClass="module-panel-summary" />
            <Label fx:id="lastUpdatedLabel" text="마지막 갱신: -" styleClass="resource-sub-label" />

            <!-- 검색 -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <children>
                    <TextField fx:id="searchField" HBox.hgrow="ALWAYS" promptText="검색: PC명, IP, MAC, 명령" />
                </children>
            </HBox>

            <!-- 필터 -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <children>
                    <Label text="상태" styleClass="meta-key" />
                    <ComboBox fx:id="statusFilterCombo" prefWidth="145" promptText="상태 선택" />
                    <Button fx:id="typeFilterBtn" styleClass="btn-neutral" prefWidth="125" text="종류 ▾">
                        <tooltip><Tooltip text="체크 해제된 종류는 목록에서 숨겨집니다" /></tooltip>
                    </Button>
                    <Label text="강의실" styleClass="meta-key" />
                    <ComboBox fx:id="roomFilterCombo" prefWidth="145" promptText="강의실 선택" />
                    <Label text="정렬" styleClass="meta-key" />
                    <ComboBox fx:id="sortCombo" prefWidth="135" promptText="정렬 기준" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="clearButton" text="필터 초기화" styleClass="btn-neutral">
                        <tooltip><Tooltip text="검색어와 모든 필터를 기본값으로 되돌립니다" /></tooltip>
                    </Button>
                </children>
            </HBox>

            <Separator />

            <StackPane fx:id="commandTableSlot" VBox.vgrow="ALWAYS" />
        </children>
    </VBox>

    <!-- ━━━━━━━━━━━━━━━━━━━ RIGHT: 명령 상세 (슬라이드) ━━━━━━━━━━━━━━━━━━━ -->
    <VBox fx:id="detailPanel" styleClass="classroom-detail-panel" spacing="12"
          minWidth="0" prefWidth="0" managed="false" visible="false">
        <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
        <children>
            <!-- 헤더 -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <children>
                    <Label fx:id="detailTitleLabel" text="명령 상세" styleClass="detail-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="detailCloseBtn" styleClass="detail-close-btn">
                        <graphic><FontIcon iconLiteral="mdi2c-close" iconSize="16" /></graphic>
                    </Button>
                </children>
            </HBox>

            <!-- 진행 단계 스텝퍼 (코드에서 채움) -->
            <HBox fx:id="progressStepsBox" alignment="CENTER_LEFT" spacing="0" styleClass="cmd-step-row" />

            <!-- 현재 상태 강조 -->
            <Label fx:id="detailStatusLine" text="" styleClass="cmd-detail-status" wrapText="true" />

            <!-- 메타 정보 (코드에서 채움) + 출력 -->
            <ScrollPane fitToWidth="true" styleClass="cmd-detail-scroll" VBox.vgrow="ALWAYS"
                        hbarPolicy="NEVER">
                <content>
                    <VBox spacing="12">
                        <children>
                            <VBox fx:id="detailMetaBox" spacing="10" />

                            <Label text="stdout" styleClass="meta-key" />
                            <TextArea fx:id="detailStdout" editable="false" wrapText="true"
                                      prefRowCount="5" styleClass="textarea-readonly" />
                            <Label text="stderr" styleClass="meta-key" />
                            <TextArea fx:id="detailStderr" editable="false" wrapText="true"
                                      prefRowCount="4" styleClass="textarea-readonly" />
                        </children>
                    </VBox>
                </content>
            </ScrollPane>

            <Button fx:id="detailDownloadBtn" text="결과 다운로드" styleClass="btn-primary-outline"
                    maxWidth="Infinity" managed="false" visible="false" />
        </children>
    </VBox>
</HBox>
