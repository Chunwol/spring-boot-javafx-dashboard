<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox fx:id="itemRow" spacing="10.0" alignment="CENTER_LEFT"
      styleClass="pcmgmt-transfer-item-row"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml">
    <children>
        <Label fx:id="nameLabel" prefWidth="260.0" styleClass="pcmgmt-transfer-item-name" />
        <Label fx:id="sizeLabel" prefWidth="90.0"  styleClass="pcmgmt-transfer-item-size" />
        <Label fx:id="typeLabel" prefWidth="50.0"  styleClass="pcmgmt-transfer-item-type" />
        <CheckBox fx:id="runCheck" text="실행" />
    </children>
</HBox>
