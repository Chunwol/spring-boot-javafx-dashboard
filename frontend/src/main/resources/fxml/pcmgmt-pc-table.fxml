<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" VBox.vgrow="ALWAYS">
    <children>
        <TableView fx:id="pcTable" styleClass="app-table" minHeight="300.0" VBox.vgrow="ALWAYS">
            <placeholder><Label text="조회된 PC가 없습니다." /></placeholder>
            <columns>
                <!-- checkCol: 헤더 클릭 전체선택, 셀 개별 체크박스 — 컨트롤러에서 세팅 -->
                <TableColumn fx:id="checkCol" prefWidth="40.0" minWidth="40.0" maxWidth="40.0" resizable="false" />
                <TableColumn fx:id="classroomCol" text="강의실" prefWidth="105.0" />
                <TableColumn fx:id="ipCol" text="IP" prefWidth="115.0" />
                <TableColumn fx:id="hostnameCol" text="호스트명" prefWidth="160.0" />
                <TableColumn fx:id="roleCol" text="역할" prefWidth="60.0" />
                <TableColumn fx:id="statusCol" text="상태" prefWidth="80.0" />
                <TableColumn fx:id="agentVersionCol" text="버전" prefWidth="80.0" />
                <TableColumn fx:id="beatCol" text="마지막 하트비트" prefWidth="150.0" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
