<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" VBox.vgrow="ALWAYS">
    <children>
        <TableView fx:id="pcTable" minHeight="300.0" VBox.vgrow="ALWAYS">
            <placeholder><Label text="조회된 PC가 없습니다." /></placeholder>
            <columns>
                <TableColumn fx:id="classroomCol" text="강의실" prefWidth="100.0" />
                <TableColumn fx:id="ipCol" text="IP" prefWidth="130.0" />
                <TableColumn fx:id="hostnameCol" text="호스트명" prefWidth="120.0" />
                <TableColumn fx:id="roleCol" text="역할" prefWidth="70.0" />
                <TableColumn fx:id="statusCol" text="상태" prefWidth="80.0" />
                <TableColumn fx:id="agentVersionCol" text="에이전트 버전" prefWidth="110.0" />
                <TableColumn fx:id="beatCol" text="마지막 하트비트" prefWidth="160.0" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
