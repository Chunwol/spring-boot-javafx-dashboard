<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>

<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="pcmgmt-section-divider"
      xmlns:fx="http://javafx.com/fxml">
    <children>
        <Label text="보기:" styleClass="pcmgmt-label-title" />
        <ComboBox fx:id="viewTypeCombo" prefWidth="140.0" promptText="보기 유형 선택" />
        <ComboBox fx:id="viewClassroomCombo" prefWidth="150.0" visible="false" managed="false" promptText="강의실 선택" />
        <Button fx:id="refreshBtn" text="새로고침" styleClass="pcmgmt-refresh-btn" />
        <Label fx:id="summaryLabel" styleClass="pcmgmt-summary-label" HBox.hgrow="ALWAYS" />
    </children>
</HBox>
