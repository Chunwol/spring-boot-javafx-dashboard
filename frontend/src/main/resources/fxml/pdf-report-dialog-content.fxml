<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.GridPane?>

<GridPane hgap="10.0" vgap="10.0" styleClass="dialog-content"
          xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0" /></padding>

    <Label text="보고서 유형을 선택하세요. 월간 보고서 선택 시 연도·월은 필수입니다."
           styleClass="mgmt-hint-label" wrapText="true"
           GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2" />

    <Label text="보고서 유형:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <RadioButton fx:id="weeklyBtn" text="주간 보고서 (이번 주)" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    <RadioButton fx:id="lastWeekBtn" text="주간 보고서 (지난 주)" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    <RadioButton fx:id="monthlyBtn" text="월간 보고서" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    <Label text="연도:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
    <ComboBox fx:id="yearCombo" promptText="연도 선택 (월간 필수)" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    <Label text="월:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
    <ComboBox fx:id="monthCombo" promptText="월 선택 (월간 필수)" GridPane.columnIndex="1" GridPane.rowIndex="5" />
</GridPane>
