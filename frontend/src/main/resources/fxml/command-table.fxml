<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>

<TableView fx:id="commandTable"
           xmlns:fx="http://javafx.com/fxml">
    <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
    </columnResizePolicy>
    <placeholder><Label text="명령 로그가 없습니다." /></placeholder>
    <columns>
        <TableColumn fx:id="timeCol" text="시간" prefWidth="160.0" />
        <TableColumn fx:id="roomCol" text="강의실" prefWidth="140.0" />
        <TableColumn fx:id="pcNameCol" text="PC명" prefWidth="170.0" />
        <TableColumn fx:id="ipCol" text="IP" prefWidth="140.0" />
        <TableColumn fx:id="macCol" text="MAC" prefWidth="170.0" />
        <TableColumn fx:id="typeCol" text="종류" prefWidth="90.0" />
        <TableColumn fx:id="transferCol" text="전송대상" prefWidth="180.0" />
        <TableColumn fx:id="destinationCol" text="대상경로" prefWidth="190.0" />
        <TableColumn fx:id="modeCol" text="실행옵션" prefWidth="220.0" />
        <TableColumn fx:id="statusCol" text="상태" prefWidth="130.0" />
        <TableColumn fx:id="exitCol" text="종료코드" prefWidth="80.0" />
        <TableColumn fx:id="detailCol" text="결과" prefWidth="100.0" />
    </columns>
</TableView>
