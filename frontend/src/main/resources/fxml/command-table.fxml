<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>

<TableView fx:id="commandTable" styleClass="app-table"
           xmlns:fx="http://javafx.com/fxml">
    <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
    </columnResizePolicy>
    <placeholder><Label text="명령 로그가 없습니다." /></placeholder>
    <columns>
        <TableColumn fx:id="timeCol" text="시간" prefWidth="150.0" />
        <TableColumn fx:id="roomCol" text="강의실" prefWidth="120.0" />
        <TableColumn fx:id="pcNameCol" text="PC명" prefWidth="140.0" />
        <TableColumn fx:id="ipCol" text="IP" prefWidth="120.0" />
        <TableColumn fx:id="macCol" text="MAC" prefWidth="150.0" />
        <TableColumn fx:id="typeCol" text="종류" prefWidth="100.0" />
        <TableColumn fx:id="transferCol" text="전송대상" prefWidth="170.0" />
        <TableColumn fx:id="destinationCol" text="대상경로" prefWidth="220.0" />
        <TableColumn fx:id="modeCol" text="실행옵션" prefWidth="200.0" />
        <TableColumn fx:id="statusCol" text="상태" prefWidth="120.0" />
        <TableColumn fx:id="exitCol" text="종료코드" prefWidth="80.0" />
        <!-- detailCol 제거: 행 클릭으로 우측 패널에서 상세 표시됨 -->
    </columns>
</TableView>
