<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>

<TableView fx:id="pcTrafficTable" prefHeight="300.0"
           styleClass="network-table"
           xmlns:fx="http://javafx.com/fxml">
    <placeholder><Label text="PC 트래픽 데이터가 없습니다." styleClass="network-placeholder" /></placeholder>
    <columns>
        <TableColumn fx:id="pcCol" text="PC명" prefWidth="120.0" />
        <TableColumn fx:id="ipCol" text="IP주소" prefWidth="120.0" />
        <TableColumn fx:id="inCol" text="입력(Mbps)" prefWidth="105.0" styleClass="network-col-right" />
        <TableColumn fx:id="outCol" text="출력(Mbps)" prefWidth="105.0" styleClass="network-col-right" />
        <TableColumn fx:id="loadCol" text="부하율" prefWidth="90.0" />
    </columns>
    <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
    </columnResizePolicy>
</TableView>
