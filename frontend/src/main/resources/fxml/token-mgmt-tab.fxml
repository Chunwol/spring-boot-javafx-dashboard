<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      styleClass="tab-main"
      maxWidth="1.7976931348623157E308"
      maxHeight="1.7976931348623157E308"
      spacing="12">
    <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
    <children>

        <Label text="토큰 관리" styleClass="tab-title" />

        <HBox alignment="CENTER_LEFT" spacing="10">
            <children>
                <Label text="보기:" styleClass="pcmgmt-label-title" />
                <ComboBox fx:id="classroomFilter" promptText="강의실 전체" prefWidth="140" styleClass="filter-combo" />
                <ComboBox fx:id="agentStatusFilter" promptText="상태 전체" prefWidth="120" styleClass="filter-combo" />
                <ComboBox fx:id="tokenStatusFilter" promptText="인증 전체" prefWidth="120" styleClass="filter-combo" />
                <TextField fx:id="tokenSearchField" prefWidth="200" promptText="검색: PC명, IP, MAC" />
                <Button fx:id="refreshBtn" text="새로고침" styleClass="btn-primary" />
                <Label fx:id="updatedLabel" text="" styleClass="pcmgmt-summary-label" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <!-- 설치키 + 등록 제어 -->
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="pcmgmt-section-divider">
            <children>
                <Label text="설치 키:" styleClass="mgmt-section-label" />
                <Label fx:id="installKeyLabel" text="불러오는 중..." styleClass="code-tag" />
                <Button fx:id="copyKeyBtn" text="복사" styleClass="btn-primary-outline,btn-sm">
                    <tooltip><Tooltip text="설치키를 클립보드에 복사합니다" /></tooltip>
                </Button>
                <Button fx:id="refreshKeyBtn" text="변경" styleClass="btn-warning,btn-sm">
                    <tooltip><Tooltip text="설치 키를 변경합니다. 기존 키는 무효화됩니다." /></tooltip>
                </Button>
                <Button fx:id="downloadConfigBtn" text="설정 파일 다운로드" styleClass="btn-neutral,btn-sm" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="신규 등록:" styleClass="mgmt-section-label" />
                <Label fx:id="registrationStatusLabel" text="불러오는 중..." styleClass="mgmt-hint-label" />
                <Button fx:id="toggleRegistrationBtn" text="..." styleClass="btn-neutral,btn-sm" disable="true" />
            </children>
        </HBox>

        <!-- 토큰 현황 테이블 -->
        <TableView fx:id="tokenTable" styleClass="app-table" VBox.vgrow="ALWAYS">
            <placeholder><Label text="등록된 에이전트가 없습니다." /></placeholder>
            <columns>
                <TableColumn fx:id="colSelect"    text=""                prefWidth="40"  />
                <TableColumn fx:id="colPcName"    text="PC명"            prefWidth="140" />
                <TableColumn fx:id="colClassroom" text="강의실"           prefWidth="120" />
                <TableColumn fx:id="colIp"        text="IP"              prefWidth="120" />
                <TableColumn fx:id="colMac"       text="MAC"             prefWidth="140" />
                <TableColumn fx:id="colStatus"    text="현재 상태"        prefWidth="100" />
                <TableColumn fx:id="colToken"     text="인증 상태"        prefWidth="110" />
                <TableColumn fx:id="colLastSeen"  text="최근 접속"        prefWidth="140" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
            </columnResizePolicy>
        </TableView>

        <!-- 하단 액션 -->
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <children>
                <Button fx:id="revokeBtn" text="토큰폐기" styleClass="btn-warning" disable="true" />
                <Button fx:id="deleteBtn" text="삭제"     styleClass="btn-danger"  disable="true" />
            </children>
        </HBox>

    </children>
</VBox>
