<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      spacing="12"
      styleClass="classroom-panel-bg">
    <padding>
        <Insets top="18" right="16" bottom="16" left="16" />
    </padding>
    <children>
        <HBox fx:id="headerBar" alignment="CENTER_RIGHT" spacing="4">
            <children>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="gridSettingsBtn" text="⚙" styleClass="btn-neutral" />
                <Button fx:id="deleteBtn" text="삭제" styleClass="btn-danger" />
            </children>
        </HBox>

        <StackPane fx:id="titleBanner" styleClass="classroom-title-banner">
            <padding>
                <Insets top="12" right="10" bottom="12" left="10" />
            </padding>
            <children>
                <Label fx:id="nameLabel" maxWidth="1.7976931348623157E308" styleClass="classroom-name-label" text="강의실" wrapText="true" />
            </children>
        </StackPane>

        <StackPane fx:id="panelNameSlot" managed="false" visible="false" />

        <HBox fx:id="countStrip" spacing="4">
            <children>
                <StackPane fx:id="totalBox" styleClass="classroom-stat-total" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="9" right="8" bottom="9" left="8" />
                    </padding>
                    <children>
                        <Label fx:id="totalLabel" styleClass="classroom-stat-label" text="0 대" />
                    </children>
                </StackPane>
                <StackPane fx:id="onlineBox" styleClass="classroom-stat-online" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="9" right="8" bottom="9" left="8" />
                    </padding>
                    <children>
                        <Label fx:id="onlineLabel" styleClass="classroom-stat-label" text="0 대" />
                    </children>
                </StackPane>
                <StackPane fx:id="offlineBox" styleClass="classroom-stat-offline" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="9" right="8" bottom="9" left="8" />
                    </padding>
                    <children>
                        <Label fx:id="offlineLabel" styleClass="classroom-stat-label" text="0 대" />
                    </children>
                </StackPane>
            </children>
        </HBox>

        <GridPane fx:id="pcGrid" hgap="6" vgap="6" VBox.vgrow="ALWAYS" />

        <HBox fx:id="buttonBox" alignment="CENTER" spacing="5">
            <children>
                <Button fx:id="shutdownAllBtn" text="전체 종료" styleClass="btn-danger" />
                <Button fx:id="wolAllBtn" text="전체 켜기" styleClass="btn-primary" />
            </children>
        </HBox>

        <HBox fx:id="resizeHandleBox" alignment="CENTER_RIGHT" managed="false" visible="false">
            <children>
                <Label fx:id="resizeHandleLabel" text="◢" />
            </children>
        </HBox>
    </children>
</VBox>
