<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.frontend.controller.panel.NetworkTabController"
      styleClass="tab-content" spacing="0">

    <!-- ━━━━━━━━━━━━━━━━━━━ LEFT: 차트 + 강의실별 표 ━━━━━━━━━━━━━━━━━━━ -->
    <VBox styleClass="tab-main" spacing="16" HBox.hgrow="ALWAYS">
        <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
        <children>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <children>
                    <Label text="네트워크" styleClass="tab-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="updatedLabel" text="" styleClass="detail-updated-label" />
                    <ComboBox fx:id="statusFilter" prefWidth="120" promptText="상태" styleClass="filter-combo" />
                    <Button fx:id="downloadBtn" styleClass="tab-icon-btn">
                        <graphic><FontIcon iconLiteral="mdi2d-download" iconSize="16" /></graphic>
                        <tooltip><Tooltip text="다운로드" /></tooltip>
                    </Button>
                    <Button fx:id="printBtn" styleClass="tab-icon-btn">
                        <graphic><FontIcon iconLiteral="mdi2p-printer" iconSize="16" /></graphic>
                        <tooltip><Tooltip text="인쇄" /></tooltip>
                    </Button>
                    <Button fx:id="refreshBtn" text="조회" styleClass="btn-primary" />
                </children>
            </HBox>

            <!-- 실시간 트래픽 라인 차트 -->
            <VBox styleClass="network-chart-card" spacing="6">
                <padding><Insets top="14" right="16" bottom="10" left="16" /></padding>
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <children>
                            <Label text="실시간 트래픽" styleClass="net-chart-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="● 인바운드" styleClass="net-legend-in" />
                            <Label text="● 아웃바운드" styleClass="net-legend-out" />
                        </children>
                    </HBox>
                    <AreaChart fx:id="trafficChart" prefHeight="220" legendVisible="false"
                               animated="false" createSymbols="false" styleClass="network-area-chart">
                        <xAxis>
                            <CategoryAxis fx:id="timeAxis" tickLabelGap="6" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="valueAxis" lowerBound="0" upperBound="100" autoRanging="true" />
                        </yAxis>
                    </AreaChart>
                </children>
            </VBox>

            <!-- 강의실별 트래픽 표 -->
            <Label text="강의실별 트래픽" styleClass="net-section-title" />
            <TableView fx:id="classroomTable" styleClass="app-table,network-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="roomCol"     text="강의실"        prefWidth="140" />
                    <TableColumn fx:id="pcCountCol"  text="PC수 (온/전)" prefWidth="120" />
                    <TableColumn fx:id="inCol"       text="인바운드(Mbps)" prefWidth="130" />
                    <TableColumn fx:id="outCol"      text="아웃바운드(Mbps)" prefWidth="130" />
                    <TableColumn fx:id="loadCol"     text="부하율"        prefWidth="200" />
                    <TableColumn fx:id="statusCol"   text="상태"          prefWidth="80" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                </columnResizePolicy>
            </TableView>
        </children>
    </VBox>

    <!-- ━━━━━━━━━━━━━━━━━━━ RIGHT: 강의실 상세 (슬라이드) ━━━━━━━━━━━━━━━━━━━ -->
    <VBox fx:id="detailPanel" styleClass="classroom-detail-panel" spacing="14"
          minWidth="0" prefWidth="0" managed="false" visible="false">
        <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
        <children>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <children>
                    <Label fx:id="detailTitleLabel" text="강의실 트래픽" styleClass="detail-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="detailCloseBtn" styleClass="detail-close-btn">
                        <graphic><FontIcon iconLiteral="mdi2c-close" iconSize="16" /></graphic>
                    </Button>
                </children>
            </HBox>

            <HBox spacing="12">
                <children>
                    <VBox styleClass="net-stat-box" HBox.hgrow="ALWAYS">
                        <padding><Insets top="10" right="14" bottom="10" left="14" /></padding>
                        <children>
                            <Label text="인바운드 합계" styleClass="net-stat-label" />
                            <Label fx:id="detailInLabel" text="0.0 Mbps" styleClass="net-stat-value-in" />
                        </children>
                    </VBox>
                    <VBox styleClass="net-stat-box" HBox.hgrow="ALWAYS">
                        <padding><Insets top="10" right="14" bottom="10" left="14" /></padding>
                        <children>
                            <Label text="아웃바운드 합계" styleClass="net-stat-label" />
                            <Label fx:id="detailOutLabel" text="0.0 Mbps" styleClass="net-stat-value-out" />
                        </children>
                    </VBox>
                </children>
            </HBox>

            <Label text="PC별 트래픽" styleClass="detail-section-title" />
            <StackPane fx:id="detailTableSlot" VBox.vgrow="ALWAYS" />
        </children>
    </VBox>
</HBox>
