<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" alignment="CENTER" spacing="12" fx:controller="com.example.frontend.controller.LoginController">
    <padding>
        <Insets top="20" right="40" bottom="20" left="40"/>
    </padding>
    <Label text="Dashboard 로그인" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label fx:id="messageLabel" text="" style="-fx-text-fill: red;" visible="false"/>
    <TextField fx:id="hostField" promptText="도메인 또는 IP" maxWidth="250"/>
    <HBox alignment="CENTER" spacing="8">
        <Label text="포트"/>
        <TextField fx:id="portField" promptText="443" maxWidth="80"/>
    </HBox>
    <TextField fx:id="usernameField" promptText="사용자명" maxWidth="250"/>
    <PasswordField fx:id="passwordField" promptText="비밀번호" maxWidth="250"/>
    <Button text="로그인" onAction="#handleLogin" defaultButton="true"/>
</VBox>
