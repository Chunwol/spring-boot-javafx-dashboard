# Local Docker deployment template
# Copy to .env, replace every CHANGE_ME value, then run scripts\deploy.bat.

# Public endpoint
DOMAIN=pelmon.kro.kr
BACKEND_HOST_PORT=8888
CORS_ALLOWED_ORIGINS=https://pelmon.kro.kr

# PostgreSQL
POSTGRES_DB=dashboard_db
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=CHANGE_ME_database_password
DB_URL=jdbc:postgresql://pgbouncer:5432/dashboard_db
DB_DRIVER=org.postgresql.Driver
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/pgmigration

# Persistent automatic backup
DB_BACKUP_ENABLED=true
DB_BACKUP_CRON=0 0 1 * * *
DB_BACKUP_ZONE=Asia/Seoul
DB_BACKUP_KEEP_DAYS=14
DB_BACKUP_TIMEOUT_MINUTES=30
DB_BACKUP_LOCK_KEY=94503177

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# Authentication and initial accounts
JWT_SECRET=CHANGE_ME_random_secret_at_least_32_characters
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=7776000000
JWT_REFRESH_COOKIE_SECURE=false
DEFAULT_ADMIN_SYNC_ON_STARTUP=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_admin_password
DEFAULT_ADMIN_EMAIL=
DEFAULT_USER_SYNC_ON_STARTUP=false
DEFAULT_USER_USERNAME=
DEFAULT_USER_PASSWORD=
DEFAULT_USER_EMAIL=
DEFAULT_VIEWER_SYNC_ON_STARTUP=true
DEFAULT_VIEWER_USERNAME=viewer
DEFAULT_VIEWER_PASSWORD=CHANGE_ME_viewer_password
DEFAULT_VIEWER_EMAIL=
ADMIN_USERS=admin
VIEWER_USERS=viewer

# Agent registration
AGENT_INSTALL_KEY=INST-CHANGE-ME-BEFORE-DEPLOY
COMMAND_TIMEOUT_SECONDS=600
COMMAND_QUEUE_TTL_SECONDS=300

# Agent updates are sent only to explicitly selected deployment targets.
FD_AUTO_CATCHUP_ON_HEARTBEAT=false

# Browser VNC relay. Restrict this to the classroom network ranges.
REMOTE_CONTROL_ALLOWED_CIDRS=223.194.166.0/23,223.194.168.0/23,172.16.13.0/24,172.16.204.0/24
REMOTE_CONTROL_MAX_SESSIONS=64

# ipTIME router WOL fallback. Configure only routers verified with the WAN WOL patch.
ROUTER_WOL_ENABLED=false
ROUTER_WOL_USERNAME=
ROUTER_WOL_PASSWORD=
ROUTER_WOL_CONNECT_TIMEOUT=2s
ROUTER_WOL_REQUEST_TIMEOUT=4s
ROUTER_WOL_DEDUP_WINDOW=2m
ROUTER_WOL_166_PRIMARY_URL=
ROUTER_WOL_166_SECONDARY_URL=
ROUTER_WOL_167_PRIMARY_URL=
ROUTER_WOL_167_SECONDARY_URL=
ROUTER_WOL_168_PRIMARY_URL=
ROUTER_WOL_168_SECONDARY_URL=
ROUTER_WOL_169_PRIMARY_URL=
ROUTER_WOL_169_SECONDARY_URL=
ROUTER_WOL_204_PRIMARY_URL=
ROUTER_WOL_204_SECONDARY_URL=
# 6 building (172.16.13.0/24): fill after routers are installed.
ROUTER_WOL_6_PRIMARY_URL=
ROUTER_WOL_6_SECONDARY_URL=

# Uploads and downloads
UPLOAD_DIR=/app/uploads/
MAX_FILE_SIZE=53687091200
MAX_REQUEST_SIZE=53687091200
COLLECT_ARTIFACT_MAX_TOTAL_BYTES=53687091200
NGINX_ACCEL_REDIRECT=false

# Runtime
SERVER_HOST=0.0.0.0
LOG_LEVEL=INFO
TRAFFIC_ALERT_THRESHOLD_GLOBAL_MBPS=2000
TRAFFIC_ALERT_THRESHOLD_CLASSROOM_MBPS=200
TRAFFIC_ALERT_THRESHOLD_PC_MBPS=50
JAVA_HEAP_MIN=512m
JAVA_HEAP_MAX=1g
# SCMATE local recovery engine credential. Keep production values only in the deployment secret store.
SCMATE_CLI_USERNAME=
SCMATE_CLI_PASSWORD=
