# Database Configuration
DB_URL=jdbc:sqlite:db/mydatabase.db
DB_DRIVER=org.sqlite.JDBC
DB_USERNAME=
DB_PASSWORD=

# Server Configuration
SERVER_PORT=8888
SERVER_HOST=pelmon.kro.kr

# JWT Configuration
JWT_SECRET=change-this-secret-key-in-production-with-a-strong-secure-string
JWT_EXPIRATION=86400000

# Default Admin Account Sync
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-admin-password
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_SYNC_ON_STARTUP=true

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM=noreply@example.com

# Application Configuration
APP_NAME=Classroom Dashboard
APP_PROFILE=default

# Logging Configuration
LOG_LEVEL=INFO

# Heartbeat Configuration
HEARTBEAT_TIMEOUT_MINUTES=5
HEARTBEAT_INTERVAL_SECONDS=120

# Traffic Threshold (in Mbps)
TRAFFIC_ALERT_THRESHOLD_MBPS=100

# File Upload
UPLOAD_DIR=uploads/
MAX_FILE_SIZE=20971520

# Server Base URL (for image file serving — must match SERVER_PORT and hostname)
SERVER_BASE_URL=https://pelmon.kro.kr

# Frontend desktop/exe overrides
FRONTEND_API_BASE_URL=https://pelmon.kro.kr/api/v1
FRONTEND_WEBSOCKET_STOMP_URL=wss://pelmon.kro.kr/ws/websocket
FRONTEND_DEFAULT_LOGIN_HOST=pelmon.kro.kr
FRONTEND_DEFAULT_LOGIN_PORT=443

# Agent overrides
AGENT_SERVER_URL=https://pelmon.kro.kr
AGENT_INSTALL_KEY=INST-CHANGE-ME-BEFORE-DEPLOY
AGENT_HEARTBEAT_INTERVAL_SEC=120
AGENT_JITTER_SEC=30

# Domain / SSL
DOMAIN=pelmon.kro.kr
EMAIL=your-email@example.com

# ZeroSSL EAB credentials (https://app.zerossl.com/developer)
ZEROSSL_EAB_KID=your-eab-kid-here
ZEROSSL_EAB_HMAC_KEY=your-eab-hmac-key-here

# JPA Configuration
JPA_SHOW_SQL=false
