# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must use LF on all platforms
*.sh text eol=lf
gradlew text eol=lf

# Windows batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files - no line ending conversion
*.jar binary
*.exe binary
*.msi binary
*.zip binary
*.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.sqlite binary
*.p12 binary
*.keystore binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Java sources - LF
*.java text eol=lf
*.kt text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
